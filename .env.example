# --- What to back up (separated by commas, spaces or new lines; mix freely) ---
#   PLxxxxxxxx              a playlist (public/unlisted with an API key; private with OAuth if you own it)
#   mine                    everything on the OAuth account: playlists, uploads, liked, subscriptions
#   @handle | channel:UCxx  everything public on a channel: playlists, uploads, subscriptions
#   <user>:<kind>[+<kind>]  only some kinds: playlists, uploads, liked (mine only), subscriptions
#   !<entry>                exclude, e.g. !PLxxxxxxxx or !mine:subscriptions
BACKUP_SOURCES=mine

# --- Where to store it: gdrive | github | local ---
STORAGE_BACKEND=gdrive

# Folder (a "/"-separated path, created if missing) and file names — used by every backend.
# BACKUP_FILE_NAME placeholders: {id}, {title}, {kind}. A "/" makes subfolders, e.g. {kind}/{id}.json
BACKUP_FOLDER=YouTube Playlist Backup
BACKUP_FILE_NAME={id}.json
DELETED_LOG_FILE_NAME=deleted_tracks.json

# --- Google OAuth (required for gdrive, for "mine..." sources and for private playlists) ---
# Get the refresh token with: npm run auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Or: API key only (public/unlisted playlists, github/local backends only) ---
YOUTUBE_API_KEY=

# --- Google Drive options ---
# Folder id to create BACKUP_FOLDER under (default: My Drive root). See README about scopes.
GDRIVE_PARENT_FOLDER_ID=

# --- GitHub options (STORAGE_BACKEND=github) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
GITHUB_BRANCH=
GITHUB_COMMIT_MESSAGE=chore: update playlist backup
